---
/**
 * Titular de puntos que se teclea.
 * - La parte base se ensambla con puntos al cargar.
 * - La parte final (acento) se borra y se vuelve a teclear: los puntos de cada letra
 *   salen desde el cursor de texto y, al borrar, caen y se desvanecen.
 * - El cursor del visitante aparta los puntos y deja una estela de «marcas de edición».
 * El <h1> real sigue en el DOM (accesibilidad y SEO); el lienzo es decorativo.
 * Sin JavaScript o con «reducir movimiento», se muestra el texto normal.
 * El tamaño se ajusta con la variable CSS --ht-tam desde la página que lo usa.
 */
interface Props {
  base: string;
  opciones: string[];
}
const { base, opciones } = Astro.props;
---

<div class="ht" data-ht data-opciones={JSON.stringify(opciones)}>
  <h1 class="ht__titular">
    <span class="ht__base">{base.split(' ').map((p) => <><span class="ht__palabra">{p}</span>{' '}</>)}</span>
    <em class="ht__acento" data-ht-acento>{opciones[0]}</em>
  </h1>
  <canvas class="ht__lienzo" aria-hidden="true"></canvas>
</div>

<script>
  const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-ht]').forEach((raiz) => { if (!reducir) iniciar(raiz); });


  const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function iniciar(raiz: HTMLElement) {
    const opciones: string[] = JSON.parse(raiz.dataset.opciones || '[]');
    if (!opciones.length) return;
    const h1 = raiz.querySelector<HTMLElement>('.ht__titular')!;
    const acentoEl = raiz.querySelector<HTMLElement>('[data-ht-acento]')!;
    const lienzo = raiz.querySelector<HTMLCanvasElement>('.ht__lienzo')!;
    const ctx = lienzo.getContext('2d');
    if (!ctx) return;
    await document.fonts.ready;

    // Partículas en arreglos planos por rendimiento.
    let n = 0;
    let hx = new Float32Array(0), hy = hx, px = hx, py = hx, vx = hx, vy = hx, alfa = hx, calor = hx, rx = hx;
    let grupo = new Int8Array(0), visible = new Uint8Array(0);
    let ancho = 0, alto = 0, dpr = 1, tam = 2;
    let renglones: number[] = [];
    let colTexto = '#000', colAcento = '#f00', colRenglon = '#ddd';
    // Geometría de la línea del acento.
    let acX = 0, acBase = 0, acAsc = 0;
    const medidor = document.createElement('canvas').getContext('2d')!;
    let opcion = 0, prefijo = opciones[0].length, escribiendo = false;
    const anchos: number[][] = []; // anchos[opción][k] = ancho del prefijo de k caracteres
    const raton = { x: -9999, y: -9999, activo: false };
    let primera = true, enPantalla = false, corriendo = false;
    let t0 = performance.now(), quieto = false, faseDibujada = -1;

    const leerColores = () => {
      const cs = getComputedStyle(document.documentElement);
      colTexto = cs.getPropertyValue('--texto').trim() || '#000';
      colAcento = cs.getPropertyValue('--acento').trim() || '#f00';
      colRenglon = cs.getPropertyValue('--borde').trim() || '#ddd';
      faseDibujada = -1;
    };
    const fuenteDe = (el: Element) => {
      const cs = getComputedStyle(el);
      return { fuente: `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`, esp: cs.letterSpacing === 'normal' ? '0px' : cs.letterSpacing };
    };
    const anchoPrefijo = (k: number) => (k > 0 ? anchos[opcion][k] : 0);

    const muestrear = () => {
      const r = h1.getBoundingClientRect();
      const rA = acentoEl.getBoundingClientRect();
      const fa = fuenteDe(acentoEl);
      medidor.font = fa.fuente;
      if ('letterSpacing' in medidor) (medidor as any).letterSpacing = fa.esp;
      anchos.length = 0;
      opciones.forEach((t) => anchos.push([...Array(t.length + 1)].map((_, k) => medidor.measureText(t.slice(0, k)).width)));
      acX = rA.left - r.left;
      // El lienzo cubre también la opción más larga del acento, sin pasar del borde de la ventana.
      const maxAcento = Math.max(...anchos.map((a) => a[a.length - 1]));
      const limiteDerecho = document.documentElement.clientWidth - r.left;
      dpr = Math.min(devicePixelRatio || 1, 2);
      ancho = Math.ceil(Math.min(Math.max(r.width, acX + maxAcento + 24), limiteDerecho));
      alto = Math.ceil(r.height);
      lienzo.width = ancho * dpr; lienzo.height = alto * dpr;
      lienzo.style.width = ancho + 'px'; lienzo.style.height = alto + 'px';

      const fs = parseFloat(getComputedStyle(h1).fontSize);
      // Retícula más fina y puntos casi juntos: la letra se lee entera sin perder la textura de píxel.
      const paso = Math.max(2, Math.round(fs / 44));
      tam = Math.max(1.7, paso * 0.92);

      const off = document.createElement('canvas'); off.width = ancho; off.height = alto;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      o.textBaseline = 'alphabetic'; o.fillStyle = '#000';
      const lineas: number[] = [];
      const pintarTexto = (el: Element, texto: string, x: number, rr: DOMRect, grosor = 0) => {
        const f = fuenteDe(el);
        o.font = f.fuente;
        if ('letterSpacing' in o) (o as any).letterSpacing = f.esp;
        const m = o.measureText('Hg');
        const y = rr.top - r.top + (rr.height - (m.fontBoundingBoxAscent + m.fontBoundingBoxDescent)) / 2 + m.fontBoundingBoxAscent;
        o.fillText(texto, x, y);
        if (grosor > 0) {
          // Contorno extra solo para el muestreo: los trazos finos reciben más puntos y la letra no se pierde.
          o.lineWidth = grosor; o.lineJoin = 'round'; o.strokeStyle = '#000';
          o.strokeText(texto, x, y);
        }
        lineas.push(Math.round(y + m.fontBoundingBoxDescent * 0.35));
        return { y, asc: m.fontBoundingBoxAscent };
      };
      const recoger = (g: number, origenX: number, destino: number[][], umbral = 140) => {
        const d = o.getImageData(0, 0, ancho, alto).data;
        for (let y = 0; y < alto; y += paso) for (let x = 0; x < ancho; x += paso) {
          if (d[(y * ancho + x) * 4 + 3] > umbral) destino.push([x, y, g, x - origenX]);
        }
        o.clearRect(0, 0, ancho, alto);
      };

      const todos: number[][] = [];
      // Base: cada palabra en su posición real, así respeta el ajuste de línea.
      h1.querySelectorAll('.ht__palabra').forEach((p) => { const rr = p.getBoundingClientRect(); pintarTexto(p, p.textContent || '', rr.left - r.left, rr); });
      recoger(-1, 0, todos);
      // Acento: cada opción se muestrea en la misma línea.
      // En pantallas pequeñas, la itálica serif del acento tiene trazos más finos que la retícula:
      // se engrosa para el muestreo y se baja el umbral, así cada letra conserva su forma en puntos.
      const grosorAcento = fs < 72 ? Math.max(0.8, fs * 0.022) : 0;
      opciones.forEach((t, g) => {
        const m = pintarTexto(acentoEl, t, acX, rA, grosorAcento);
        acBase = m.y; acAsc = m.asc;
        recoger(g, acX, todos, grosorAcento ? 120 : 140);
      });
      renglones = [...new Set(lineas)].sort((a, b) => a - b).filter((v, i, a) => i === 0 || v - a[i - 1] > 4);

      n = todos.length;
      hx = new Float32Array(n); hy = new Float32Array(n); px = new Float32Array(n); py = new Float32Array(n);
      vx = new Float32Array(n); vy = new Float32Array(n); alfa = new Float32Array(n); calor = new Float32Array(n);
      rx = new Float32Array(n); grupo = new Int8Array(n); visible = new Uint8Array(n);
      for (let i = 0; i < n; i++) {
        const [x, y, g, rel] = todos[i];
        hx[i] = x; hy[i] = y; grupo[i] = g; rx[i] = rel;
        if (primera && g === -1) {
          // Entrada: la base se ensambla desde una nube dispersa.
          const a = Math.random() * Math.PI * 2, d = 150 + Math.random() * Math.max(ancho, alto) * 0.7;
          px[i] = x + Math.cos(a) * d; py[i] = y + Math.sin(a) * d * 0.5;
        } else { px[i] = x; py[i] = y; }
        if (g === -1) { visible[i] = 1; alfa[i] = 1; }
      }
      aplicarPrefijo(primera);
      primera = false; quieto = false; faseDibujada = -1;
    };

    /** Muestra los puntos del acento hasta el prefijo tecleado; los que sobran caen. */
    const aplicarPrefijo = (desdeCursor = true) => {
      const limite = prefijo > 0 ? anchoPrefijo(prefijo) + 0.5 : -1;
      const cx = acX + Math.max(0, limite);
      for (let i = 0; i < n; i++) {
        const g = grupo[i]; if (g === -1) continue;
        const debe = g === opcion && rx[i] <= limite;
        if (debe && !visible[i]) {
          visible[i] = 1; alfa[i] = 1;
          if (desdeCursor) { px[i] = cx + (Math.random() - 0.5) * 6; py[i] = acBase - acAsc * 0.4 + (Math.random() - 0.5) * acAsc * 0.8; vx[i] = vy[i] = 0; }
          else { px[i] = hx[i]; py[i] = hy[i]; }
        } else if (!debe && visible[i]) {
          visible[i] = 0; vx[i] = (Math.random() - 0.5) * 3; vy[i] = -Math.random() * 2.5;
        }
      }
      quieto = false;
    };

    /** Avanza un paso la simulación. Devuelve true cuando todo está en reposo. */
    const fisica = () => {
      const radio = Math.max(70, ancho * 0.08), radio2 = radio * radio;
      let energia = 0, activos = 0;
      for (let i = 0; i < n; i++) {
        if (visible[i]) {
          let fx = (hx[i] - px[i]) * 0.07, fy = (hy[i] - py[i]) * 0.07;
          if (raton.activo) {
            const dx = px[i] - raton.x, dy = py[i] - raton.y, d2 = dx * dx + dy * dy;
            if (d2 < radio2) {
              const d = Math.sqrt(d2) || 1, f = 1 - d / radio;
              fx += (dx / d) * f * 5; fy += (dy / d) * f * 5;
              calor[i] = Math.min(1, calor[i] + f * 0.3);
            }
          }
          vx[i] = (vx[i] + fx) * 0.8; vy[i] = (vy[i] + fy) * 0.8;
        } else if (alfa[i] > 0) {
          vy[i] += 0.35; vx[i] *= 0.98; alfa[i] = Math.max(0, alfa[i] - 0.03); activos++;
        } else continue;
        px[i] += vx[i]; py[i] += vy[i];
        if (calor[i] > 0.005) { calor[i] *= 0.975; activos++; } else calor[i] = 0;
        energia += Math.abs(vx[i]) + Math.abs(vy[i]) + (Math.abs(hx[i] - px[i]) + Math.abs(hy[i] - py[i])) * 0.05;
      }
      return energia / Math.max(n, 1) < 0.004 && activos === 0;
    };

    const dibujar = (t: number) => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, ancho, alto);
      // Renglones de cuaderno.
      ctx.fillStyle = colRenglon;
      for (const y of renglones) ctx.fillRect(0, y, ancho, 1);
      for (let pase = 0; pase < 2; pase++) {
        ctx.fillStyle = pase === 0 ? colTexto : colAcento;
        for (let i = 0; i < n; i++) {
          if (alfa[i] <= 0.02) continue;
          // El cursor invierte el color: marca en naranja la base y en negro el acento.
          const naranja = (grupo[i] >= 0) !== (calor[i] > 0.35);
          if ((pase === 1) !== naranja) continue;
          ctx.globalAlpha = alfa[i];
          // Cada punto se centra en su muestra para respetar la silueta exacta de la letra.
          ctx.fillRect(px[i] - tam / 2, py[i] - tam / 2, tam, tam);
        }
      }
      ctx.globalAlpha = 1;
      // Cursor de texto: fijo mientras se escribe, parpadeante en reposo.
      if (escribiendo || Math.floor((t - t0) / 530) % 2 === 0) {
        ctx.fillStyle = colAcento;
        ctx.fillRect(acX + anchoPrefijo(prefijo) + tam * 2, acBase - acAsc * 0.78, Math.max(2, tam * 1.4), acAsc * 0.92);
      }
    };

    const cuadro = (t: number) => {
      if (!enPantalla) { corriendo = false; return; }
      if (quieto && !raton.activo && !escribiendo) {
        // En reposo solo se redibuja cuando cambia el parpadeo del cursor: ahorra batería.
        const fase = Math.floor((t - t0) / 530) % 2;
        if (fase !== faseDibujada) { faseDibujada = fase; dibujar(t); }
      } else {
        quieto = fisica() && !raton.activo && !escribiendo;
        dibujar(t); faseDibujada = -1;
      }
      requestAnimationFrame(cuadro);
    };
    const arrancar = () => { if (!corriendo && enPantalla) { corriendo = true; requestAnimationFrame(cuadro); } };

    // Ciclo de tecleo del acento.
    // Tiempos según lectura: a 200–250 palabras por minuto, el titular completo (8 palabras) se lee
    // en unos 2,2 s; se suma margen para notar el cambio. La primera vez se da más tiempo porque
    // el visitante aún está leyendo todo el titular.
    const LECTURA_INICIAL = 4800, LECTURA = 3600;
    const ciclo = async () => {
      let primeraVuelta = true;
      while (true) {
        await espera(primeraVuelta ? LECTURA_INICIAL : LECTURA);
        primeraVuelta = false;
        escribiendo = true;
        while (prefijo > 0) { prefijo--; acentoEl.textContent = opciones[opcion].slice(0, prefijo); aplicarPrefijo(); await espera(32); }
        await espera(320);
        opcion = (opcion + 1) % opciones.length;
        const t = opciones[opcion];
        for (let k = 1; k <= t.length; k++) {
          prefijo = k; acentoEl.textContent = t.slice(0, k); aplicarPrefijo();
          await espera(85 * (0.7 + Math.random() * 0.6) + (t[k - 1] === ' ' ? 70 : 0));
        }
        escribiendo = false; t0 = performance.now();
      }
    };

    leerColores();
    muestrear();
    raiz.classList.add('ht--activo');

    new IntersectionObserver((e) => { enPantalla = e[0].isIntersecting; arrancar(); }, { threshold: 0 }).observe(raiz);
    new IntersectionObserver((e, ob) => { if (e[0].isIntersecting) { ciclo(); ob.disconnect(); } }, { threshold: 0.4 }).observe(raiz);

    const mover = (x: number, y: number) => { const r = lienzo.getBoundingClientRect(); raton.x = x - r.left; raton.y = y - r.top; raton.activo = true; quieto = false; };
    raiz.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') mover(e.clientX, e.clientY); });
    raiz.addEventListener('pointerleave', () => { raton.activo = false; });
    // En pantallas táctiles, un toque aparta los puntos alrededor del dedo.
    raiz.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      mover(e.clientX, e.clientY);
      setTimeout(() => { raton.activo = false; }, 350);
    });

    // Si cambia el ancho, se vuelve a muestrear con la primera opción para medir un layout estable.
    let tr: number | undefined, anchoPrevio = raiz.clientWidth;
    new ResizeObserver(() => {
      if (raiz.clientWidth === anchoPrevio) return;
      anchoPrevio = raiz.clientWidth;
      clearTimeout(tr);
      tr = window.setTimeout(() => {
        const txt = acentoEl.textContent;
        acentoEl.textContent = opciones[0];
        muestrear();
        acentoEl.textContent = txt;
      }, 150);
    }).observe(raiz);
    new MutationObserver(leerColores).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', leerColores);
  }
</script>

<style>
  .ht { position: relative; touch-action: pan-y; }
  .ht__titular {
    font-family: var(--display); font-weight: 600;
    font-size: var(--ht-tam, clamp(2.25rem, 6.6vw, 6rem));
    line-height: 1.04; letter-spacing: -0.045em; max-width: 19ch;
  }
  .ht__palabra { display: inline-block; }
  .ht__acento { display: block; min-height: 1.04em; white-space: nowrap; font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; color: var(--acento); }
  .ht__lienzo { position: absolute; left: 0; top: 0; pointer-events: none; }

  /* Con el lienzo activo, el texto real se vuelve transparente: sigue disponible para lectores
     de pantalla y buscadores, pero no deja rastro visible cuando el cursor aparta los puntos. */
  .ht--activo .ht__titular, .ht--activo .ht__acento { color: transparent; }
</style>
