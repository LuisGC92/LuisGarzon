---
/**
 * Carrusel de marcas: logos en blanco y negro que pasan a color al seleccionarlos
 * (cursor encima, foco con teclado o toque en pantallas táctiles).
 * Logos vigentes tomados de los sitios oficiales o, cuando bloquean el acceso, de la versión
 * fechada más reciente en Wikimedia Commons.
 */
import { url } from '../config';

// `escala` equilibra el peso visual entre logos de proporciones distintas.
// `oscuro`: versión para fondo oscuro (solo los negros pasan a blanco; los colores de marca no cambian).
const marcas = [
  { nombre: 'Mercado Libre', archivo: 'mercado-libre.webp', escala: 1, oscuro: 'mercado-libre-oscuro.png' },
  { nombre: 'Mercado Pago', archivo: 'mercado-pago.png', escala: 1, oscuro: 'mercado-pago-oscuro.png' },
  { nombre: 'Mercedes-Benz', archivo: 'mercedes.svg', escala: 1.35, oscuro: 'mercedes-oscuro.svg' },
  { nombre: 'Freightliner', archivo: 'freightliner.svg', escala: 0.85 },
  { nombre: 'FUSO', archivo: 'fuso.svg', escala: 0.72, oscuro: 'fuso-oscuro.svg' },
  { nombre: 'DiDi', archivo: 'didi.svg', escala: 0.8, oscuro: 'didi-oscuro.svg' },
  { nombre: 'Itaú', archivo: 'itau.svg', escala: 1.15 },
  { nombre: 'Colsubsidio', archivo: 'colsubsidio.svg', escala: 0.8 },
  { nombre: 'Cámara de Comercio de Bogotá', archivo: 'ccb.svg', escala: 1.15, oscuro: 'ccb-oscuro.svg' },
];
---

<section class="marcas" aria-labelledby="marcas-titulo">
  <div class="contenedor marcas__cabeza" data-reveal>
    <p class="eyebrow">Marcas</p>
    <h2 id="marcas-titulo">Marcas con las que he <em>trabajado</em></h2>
  </div>

  <div class="marcas__carril" data-marcas>
    <div class="marcas__pista">
      {[0, 1].map((copia) => (
        <ul class="marcas__lista" aria-hidden={copia === 1 ? 'true' : undefined}>
          {marcas.map((m) => (
            <li class="marca-logo" tabindex={copia === 0 ? 0 : -1} style={`--escala:${m.escala}`}>
              <img class:list={['marca-logo__img', { 'marca-logo__img--claro': m.oscuro }]} src={url(`/marcas/${m.archivo}`)} alt={copia === 0 ? m.nombre : ''} loading="lazy" decoding="async" draggable="false" />
              {m.oscuro && <img class="marca-logo__img marca-logo__img--oscuro" src={url(`/marcas/${m.oscuro}`)} alt="" loading="lazy" decoding="async" draggable="false" />}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<script>
  // En pantallas táctiles no hay cursor: un toque selecciona el logo y lo muestra a color.
  document.querySelectorAll<HTMLElement>('[data-marcas]').forEach((carril) => {
    const logos = [...carril.querySelectorAll<HTMLElement>('.marca-logo')];
    carril.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('.marca-logo');
      if (!li) return;
      const activo = li.classList.contains('marca-logo--activo');
      logos.forEach((l) => l.classList.remove('marca-logo--activo'));
      if (!activo) li.classList.add('marca-logo--activo');
      carril.classList.toggle('marcas__carril--pausado', !activo);
    });
    document.addEventListener('click', (e) => {
      if (carril.contains(e.target as Node)) return;
      logos.forEach((l) => l.classList.remove('marca-logo--activo'));
      carril.classList.remove('marcas__carril--pausado');
    });
  });
</script>

<style>
  .marcas { padding-top: clamp(5rem, 12vw, 9rem); }
  .marcas__cabeza { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .marcas__cabeza h2 { font-size: clamp(2.5rem, 7vw, 5rem); letter-spacing: -0.045em; }

  .marcas__carril {
    overflow: hidden;
    /* Los bordes se desvanecen para que los logos entren y salgan con suavidad. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marcas__pista { display: flex; width: max-content; animation: desplazar 48s linear infinite; }
  .marcas__carril:hover .marcas__pista,
  .marcas__carril:focus-within .marcas__pista,
  .marcas__carril--pausado .marcas__pista { animation-play-state: paused; }
  .marcas__lista { display: flex; gap: clamp(1.5rem, 4vw, 3.5rem); list-style: none; margin: 0; padding: 0 clamp(0.75rem, 2vw, 1.75rem); }
  @keyframes desplazar { to { transform: translateX(-50%); } }

  /* Sin contenedor visible: la caja solo da un área común para que los logos se alineen. */
  .marca-logo {
    flex: 0 0 auto; display: grid; place-items: center;
    width: clamp(8.5rem, 17vw, 11.5rem); height: clamp(4.5rem, 8vw, 6rem);
    border-radius: 12px; cursor: pointer; outline-offset: 2px;
  }
  /* Caja fija con object-fit: cada logo, SVG o imagen, se ajusta sin recortarse. */
  .marca-logo__img {
    grid-area: 1 / 1;
    width: 86%; height: calc(46% * var(--escala)); min-width: 0; min-height: 0; object-fit: contain;
    filter: grayscale(1) contrast(1.15); opacity: 0.72;
    transition: filter 0.45s var(--ease), opacity 0.45s var(--ease), transform 0.45s var(--ease);
    user-select: none;
  }
  .marca-logo:hover .marca-logo__img, .marca-logo:focus-visible .marca-logo__img, .marca-logo--activo .marca-logo__img { filter: none; opacity: 1; transform: scale(1.04); }

  /* Versión para fondo oscuro: se muestra según el tema activo. */
  .marca-logo__img--oscuro { display: none; }
  :global(:root[data-theme='dark']) .marca-logo__img--claro { display: none; }
  :global(:root[data-theme='dark']) .marca-logo__img--oscuro { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .marca-logo__img--claro { display: none; }
    :global(:root:not([data-theme='light'])) .marca-logo__img--oscuro { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marcas__pista { animation: none; width: auto; justify-content: center; }
    .marcas__lista { flex-wrap: wrap; justify-content: center; padding-inline: var(--gutter); }
    .marcas__lista[aria-hidden] { display: none; }
    .marcas__carril { -webkit-mask-image: none; mask-image: none; }
  }
</style>
