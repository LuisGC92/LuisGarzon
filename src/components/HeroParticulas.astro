---
/**
 * Titular interactivo: el texto se dibuja con partículas que se ensamblan al cargar
 * y se apartan del cursor (o del dedo) para luego volver a su sitio.
 * El <h1> real sigue en el DOM para accesibilidad y SEO; el lienzo es decorativo.
 * Sin JavaScript o con «reducir movimiento», se muestra el texto normal.
 */
interface Props {
  lineas: { texto: string; acento?: boolean }[][];
}
const { lineas } = Astro.props;
---

<div class="hp" data-hp>
  <h1 class="hp__titulo">
    {lineas.map((linea) => (
      <span class="hp__linea">
        {linea.map((tramo, i) => (
          <>
            {i > 0 && ' '}
            {tramo.acento ? <em data-tramo>{tramo.texto}</em> : <span data-tramo>{tramo.texto}</span>}
          </>
        ))}
      </span>
    ))}
  </h1>
  <canvas class="hp__lienzo" aria-hidden="true"></canvas>
</div>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-hp]');
  const reducir = matchMedia('(prefers-reduced-motion: reduce)');

  if (raiz && !reducir.matches) iniciar(raiz);

  async function iniciar(raiz: HTMLElement) {
    const h1 = raiz.querySelector<HTMLElement>('.hp__titulo')!;
    const lienzo = raiz.querySelector<HTMLCanvasElement>('.hp__lienzo')!;
    const ctx = lienzo.getContext('2d')!;
    await document.fonts.ready;

    let n = 0;
    let px = new Float32Array(0), py = new Float32Array(0);
    let vx = new Float32Array(0), vy = new Float32Array(0);
    let hx = new Float32Array(0), hy = new Float32Array(0);
    let acento = new Uint8Array(0);
    let tam = 2, ancho = 0, alto = 0, dpr = 1;
    let colTexto = '#000', colAcento = '#f00';
    const raton = { x: -9999, y: -9999, activo: false };
    let animando = false;
    let primera = true;

    const leerColores = () => {
      const cs = getComputedStyle(document.documentElement);
      colTexto = cs.getPropertyValue('--texto').trim() || '#000';
      colAcento = cs.getPropertyValue('--acento').trim() || '#f00';
    };

    /** Dibuja el texto fuera de pantalla y toma una muestra de puntos de sus píxeles. */
    const muestrear = () => {
      const r = h1.getBoundingClientRect();
      dpr = Math.min(devicePixelRatio || 1, 2);
      ancho = Math.ceil(r.width);
      alto = Math.ceil(r.height);
      lienzo.width = ancho * dpr;
      lienzo.height = alto * dpr;
      lienzo.style.width = ancho + 'px';
      lienzo.style.height = alto + 'px';

      const off = document.createElement('canvas');
      off.width = ancho; off.height = alto;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      o.textBaseline = 'alphabetic';

      // Canal rojo = texto base, canal azul = acento.
      h1.querySelectorAll<HTMLElement>('[data-tramo]').forEach((el) => {
        const cs = getComputedStyle(el);
        o.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        o.fillStyle = el.tagName === 'EM' ? '#0000ff' : '#ff0000';
        const ls = parseFloat(cs.letterSpacing) || 0;
        if ('letterSpacing' in o) (o as any).letterSpacing = `${ls}px`;
        const rango = document.createRange();
        rango.selectNodeContents(el);
        for (const rr of rango.getClientRects()) {
          const m = o.measureText('Hg');
          const asc = m.fontBoundingBoxAscent, desc = m.fontBoundingBoxDescent;
          const y = rr.top - r.top + (rr.height - (asc + desc)) / 2 + asc;
          // Si el tramo ocupa varias líneas, se dibuja el texto completo en cada una y se recorta.
          o.save();
          o.beginPath(); o.rect(rr.left - r.left - 2, rr.top - r.top, rr.width + 4, rr.height); o.clip();
          o.fillText(el.textContent || '', rr.left - r.left, y);
          o.restore();
        }
      });

      const fs = parseFloat(getComputedStyle(h1).fontSize);
      const paso = Math.max(2, Math.round(fs / 32));
      tam = Math.max(1.3, paso * (fs < 70 ? 0.85 : 0.66));
      const datos = o.getImageData(0, 0, ancho, alto).data;
      const xs: number[] = [], ys: number[] = [], ac: number[] = [];
      for (let y = 0; y < alto; y += paso) {
        for (let x = 0; x < ancho; x += paso) {
          const i = (y * ancho + x) * 4;
          if (datos[i + 3] > 140) { xs.push(x); ys.push(y); ac.push(datos[i + 2] > datos[i] ? 1 : 0); }
        }
      }
      n = xs.length;
      hx = Float32Array.from(xs); hy = Float32Array.from(ys); acento = Uint8Array.from(ac);
      const nuevo = px.length !== n || primera;
      if (nuevo) {
        px = new Float32Array(n); py = new Float32Array(n);
        vx = new Float32Array(n); vy = new Float32Array(n);
        for (let i = 0; i < n; i++) {
          if (primera) {
            // Entrada: las partículas llegan desde una nube dispersa.
            const ang = Math.random() * Math.PI * 2, rad = 200 + Math.random() * Math.max(ancho, alto);
            px[i] = hx[i] + Math.cos(ang) * rad * 0.6;
            py[i] = hy[i] + Math.sin(ang) * rad * 0.35;
          } else { px[i] = hx[i]; py[i] = hy[i]; }
        }
      }
      primera = false;
    };

    const paso = () => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, ancho, alto);
      const radio = Math.max(70, ancho * 0.08), radio2 = radio * radio;
      let energia = 0;
      ctx.fillStyle = colTexto;
      for (let pase = 0; pase < 2; pase++) {
        if (pase === 1) ctx.fillStyle = colAcento;
        for (let i = 0; i < n; i++) {
          if (acento[i] !== pase) continue;
            let fx = (hx[i] - px[i]) * 0.045, fy = (hy[i] - py[i]) * 0.045;
            if (raton.activo) {
              const dx = px[i] - raton.x, dy = py[i] - raton.y, d2 = dx * dx + dy * dy;
              if (d2 < radio2) {
                const d = Math.sqrt(d2) || 1, f = (1 - d / radio) * 6;
                // Empuje radial con un leve giro para que se sienta orgánico.
                fx += (dx / d) * f - (dy / d) * f * 0.35;
                fy += (dy / d) * f + (dx / d) * f * 0.35;
              }
            }
            vx[i] = (vx[i] + fx) * 0.84; vy[i] = (vy[i] + fy) * 0.84;
            px[i] += vx[i]; py[i] += vy[i];
            energia += Math.abs(vx[i]) + Math.abs(vy[i]);
          ctx.fillRect(px[i], py[i], tam, tam);
        }
      }
      // Si todo está quieto y el cursor no está encima, se detiene el bucle para ahorrar batería.
      if (energia / Math.max(n, 1) < 0.004 && !raton.activo) { animando = false; return; }
      requestAnimationFrame(paso);
    };
    const despertar = () => { if (!animando) { animando = true; requestAnimationFrame(paso); } };

    leerColores();
    muestrear();
    raiz.classList.add('hp--activo');
    despertar();

    const mover = (x: number, y: number) => {
      const r = lienzo.getBoundingClientRect();
      raton.x = x - r.left; raton.y = y - r.top; raton.activo = true; despertar();
    };
    raiz.addEventListener('pointermove', (e) => mover(e.clientX, e.clientY));
    raiz.addEventListener('pointerleave', () => { raton.activo = false; });
    raiz.addEventListener('touchend', () => { raton.activo = false; });

    let t: number | undefined;
    new ResizeObserver(() => {
      clearTimeout(t);
      t = window.setTimeout(() => { muestrear(); despertar(); }, 150);
    }).observe(h1);

    const alCambiarTema = () => { leerColores(); despertar(); };
    new MutationObserver(alCambiarTema).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', alCambiarTema);
  }
</script>

<style>
  .hp { position: relative; touch-action: pan-y; }
  .hp__titulo { font-size: clamp(2.75rem, 9.5vw, 8.25rem); letter-spacing: -0.05em; line-height: 0.98; }
  .hp__linea { display: block; padding-bottom: 0.08em; }
  .hp__titulo em { color: var(--acento); padding-right: 0.05em; }
  .hp__lienzo { position: absolute; inset: 0; pointer-events: none; }
  /* Con el lienzo activo, el texto real queda transparente pero sigue ahí para lectores de pantalla y para seleccionar. */
  .hp--activo .hp__titulo, .hp--activo .hp__titulo em { color: transparent; }
  .hp--activo .hp__titulo ::selection { color: var(--sobre-acento); }
</style>
