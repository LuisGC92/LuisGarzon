---
import type { CollectionEntry } from 'astro:content';
import { url } from '../config';

interface Props { caso: CollectionEntry<'casos'>; indice: number; }
const { caso, indice } = Astro.props;
const d = caso.data;
---

<article class="tarjeta" data-reveal>
  <a href={url(`/casos/${caso.id}`)} class="tarjeta__enlace">
    <div class="tarjeta__media">
      <img src={url(d.portada)} alt={d.portadaAlt} loading={indice === 0 ? 'eager' : 'lazy'} />
    </div>
    <div class="tarjeta__info">
      <div class="tarjeta__meta">
        <span>{String(indice + 1).padStart(2, '0')}</span>
        <span>{d.anio}</span>
      </div>
      <h3>{d.titulo} <span class="flecha" aria-hidden="true">↗</span></h3>
      <p>{d.resumen}</p>
      <ul class="tarjeta__etiquetas" aria-label="Disciplinas">
        {d.etiquetas.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </a>
</article>

<style>
  .tarjeta__enlace { display: grid; gap: clamp(1.25rem, 3vw, 3rem); align-items: center; }
  .tarjeta__media {
    position: relative; overflow: hidden; aspect-ratio: 4 / 3;
    border-radius: var(--radio); background: var(--superficie);
    display: grid; place-items: center;
  }
  .tarjeta__media::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 70% 20%, color-mix(in srgb, var(--acento) 22%, transparent), transparent 60%);
    opacity: 0; transition: opacity 0.6s var(--ease);
  }
  .tarjeta__media img {
    position: absolute; left: 50%; top: 12%;
    width: auto; max-width: none; height: 100%; border-radius: 22px;
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.35);
    transform: translateX(-50%) rotate(-4deg);
    transition: transform 0.8s var(--ease);
  }
  .tarjeta__enlace:hover .tarjeta__media::after { opacity: 1; }
  .tarjeta__enlace:hover .tarjeta__media img { transform: translate(-50%, -4%) rotate(0deg) scale(1.03); }
  .tarjeta__meta { display: flex; gap: 1rem; font-size: 0.8125rem; color: var(--texto-suave); font-variant-numeric: tabular-nums; margin-bottom: 0.75rem; }
  .tarjeta__meta span:first-child { color: var(--acento-texto); font-weight: 600; }
  h3 { font-size: clamp(2rem, 5vw, 3.5rem); letter-spacing: -0.04em; transition: color 0.3s; }
  .tarjeta__enlace:hover h3 { color: var(--acento-texto); }
  .flecha { font-size: 0.6em; vertical-align: 0.35em; }
  p { color: var(--texto-suave); margin: 1rem 0 1.25rem; max-width: 38ch; }
  .tarjeta__etiquetas { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .tarjeta__etiquetas li { font-size: 0.8125rem; padding: 0.3rem 0.75rem; border: 1px solid var(--borde); border-radius: 999px; }
  @media (min-width: 52rem) {
    .tarjeta__enlace { grid-template-columns: 1.35fr 1fr; }
  }
</style>
