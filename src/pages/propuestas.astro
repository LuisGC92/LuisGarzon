---
// Página temporal para elegir el hero. No está enlazada ni se indexa.
import Base from '../layouts/Base.astro';

// Reescritura: cada tramo de jerga tiene su reemplazo y el motivo del cambio.
const tramos = [
  { antes: 'Implementamos soluciones', despues: 'Diseño contenido', motivo: 'Verbo vacío', sugerencia: 'Di qué haces' },
  { antes: 'de interacción orientadas a optimizar', despues: 'que hace que un producto', motivo: 'Jerga', sugerencia: 'Habla del producto' },
  { antes: 'la experiencia.', despues: 'se entienda.', motivo: 'Abstracto', sugerencia: 'Nombra el resultado', acento: true },
];

---

<Base titulo="Propuestas de hero" noindex>
  <section class="contenedor intro">
    <p class="eyebrow">Exploración · Hero de la portada · Ronda 3</p>
    <h1>Cuatro caminos para el <em>hero</em></h1>
    <p class="intro__texto">Todas parten de tu oficio: el contenido se escribe, se corrige y resuelve un problema delante del visitante. En el móvil se animan solas.</p>
  </section>

  <!-- 01 · Reescritura en vivo (v2) -->
  <section class="propuesta" id="p1">
    <div class="contenedor">
      <header class="cab">
        <span class="cab__num">01</span>
        <div>
          <h2>Reescritura en vivo <span class="cab__tag">v2</span></h2>
          <p><strong>Concepto:</strong> un editor detecta la jerga como lo haría un corrector —con subrayado ondulado y una sugerencia— y la reescribe tramo a tramo. Un panel lateral muestra cómo mejora la claridad en cada cambio: el racional, visible.</p>
        </div>
      </header>
      <div class="lienzo rw" data-rw>
        <div class="rw__editor">
          <div class="rw__barra" aria-hidden="true">
            <span class="rw__pestana rw__pestana--activa">titular.txt</span>
            <span class="rw__estado" data-rw-estado>Revisando…</span>
          </div>
          <p class="rw__texto" aria-label="Diseño contenido que hace que un producto se entienda.">
            {tramos.map((t, i) => (
              <>
                <span class={`rw__tramo${t.acento ? ' rw__tramo--acento' : ''}`} data-tramo={i} data-antes={t.antes} data-despues={t.despues} aria-hidden="true">
                  <span class="rw__sugerencia" aria-hidden="true"><b>{t.motivo}</b> · {t.sugerencia}</span>
                  <span class="rw__contenido">{t.antes}</span>
                </span>{' '}
              </>
            ))}
            <span class="rw__caret" aria-hidden="true"></span>
          </p>
        </div>
        <aside class="rw__panel" aria-hidden="true">
          <p class="rw__panel-titulo">Análisis</p>
          <div class="rw__metrica">
            <div class="rw__fila"><span>Claridad</span><b data-rw-claridad>32</b></div>
            <div class="rw__barra-progreso"><span data-rw-barra></span></div>
          </div>
          <div class="rw__metrica rw__metrica--doble">
            <div><span>Jerga</span><b data-rw-jerga>3</b></div>
            <div><span>Términos vagos</span><b data-rw-palabras>2</b></div>
          </div>
          <ol class="rw__log" data-rw-log></ol>
        </aside>
        <button class="repetir" type="button" data-rw-repetir>↺ Repetir</button>
      </div>
    </div>
  </section>

  <!-- 02 · Microcopy vivo (v2) -->
  <section class="propuesta" id="p2">
    <div class="contenedor">
      <header class="cab">
        <span class="cab__num">02</span>
        <div>
          <h2>Microcopy vivo <span class="cab__tag">v2</span></h2>
          <p><strong>Concepto:</strong> el final del titular se borra y se vuelve a teclear con cada objetivo que cumples —entender, generar confianza, convertir—. Un solo gesto, limpio, que muestra el impacto de tu trabajo.</p>
        </div>
      </header>
      <div class="lienzo micro" data-micro>
        <p class="titular micro__titular">
          Diseño contenido que hace que un producto <em class="micro__tecleo"><span data-micro-texto>se entienda.</span><span class="caret" aria-hidden="true"></span></em>
        </p>
      </div>
    </div>
  </section>

  <!-- 03 · Conversación -->
  <section class="propuesta" id="p3">
    <div class="contenedor">
      <header class="cab">
        <span class="cab__num">03</span>
        <div>
          <h2>Conversación</h2>
          <p><strong>Concepto:</strong> un caso puntual de servicio resuelto con contenido. Una persona no pudo completar su compra y no sabe si le cobraron; la interfaz le responde qué pasó, qué no pasó y qué hacer ahora, hasta que la compra se concreta.</p>
        </div>
      </header>
      <div class="lienzo conv" data-conv>
        <p class="titular conv__titular"><span data-conv-titular></span><em data-conv-acento></em><span class="caret" aria-hidden="true"></span></p>
        <div class="conv__chat" aria-hidden="true">
          <div class="conv__cabecera"><span class="conv__avatar"></span><div><b>Ayuda · Tienda en línea</b><small data-conv-estado>en línea</small></div></div>
          <div class="conv__mensajes" data-conv-mensajes></div>
        </div>
        <p class="conv__caso" aria-hidden="true">Caso: pago rechazado en el checkout</p>
      </div>
    </div>
  </section>

  <!-- 05 · Del problema al impacto -->
  <section class="propuesta" id="p5">
    <div class="contenedor">
      <header class="cab">
        <span class="cab__num">05</span>
        <div>
          <h2>Del problema al impacto <span class="cab__tag">nueva</span></h2>
          <p><strong>Concepto:</strong> un solo componente de interfaz recorre tu proceso completo. Primero se ve la fricción (UX), luego reescribes el contenido, después cobra forma en la interfaz (UI) y al final aparece el impacto en el negocio. Es el portafolio resumido en una animación.</p>
        </div>
      </header>
      <div class="lienzo imp" data-imp>
        <div class="imp__lado">
          <p class="titular imp__titular">Diseño contenido que hace que un producto <em>se entienda.</em></p>
          <ol class="imp__pasos">
            <li><button type="button" data-ir="0"><span class="imp__etq">UX</span>Detecto la fricción<i></i></button></li>
            <li><button type="button" data-ir="1"><span class="imp__etq">Contenido</span>Escribo la solución<i></i></button></li>
            <li><button type="button" data-ir="2"><span class="imp__etq">UI</span>La llevo a la interfaz<i></i></button></li>
            <li><button type="button" data-ir="3"><span class="imp__etq">Impacto</span>Muevo el indicador<i></i></button></li>
          </ol>
        </div>
        <div class="imp__escena" aria-hidden="true">
          <div class="imp__movil">
            <p class="imp__appbar"><span>‹</span> Ajustes de fotos</p>
            <div class="imp__fila">
              <span class="imp__icono">☁</span>
              <div class="imp__textos">
                <b data-imp-titulo>Sincronización inteligente</b>
                <small data-imp-ayuda>Optimiza la gestión de contenidos multimedia.</small>
              </div>
              <span class="imp__switch"><span></span></span>
            </div>
            <div class="imp__zona">
            <p class="imp__duda">«¿Esto qué hace? ¿Gasta mis datos?»</p>
            <ul class="imp__principios"><li>Qué hace</li><li>Qué no hace</li><li>Cuándo</li></ul>
            <p class="imp__toast">✓ Listo. Tus fotos se guardarán con wifi.</p>
            </div>
            <div class="imp__kpis">
              <div><span>Activación de la función</span><b class="sube">↑</b><i><s style="--v:0.78"></s></i></div>
              <div><span>Consultas a soporte</span><b class="baja">↓</b><i><s style="--v:0.3"></s></i></div>
              <small>Indicadores a medir tras el lanzamiento</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));

  /** Teclea texto en un elemento; se cancela si cambia el turno. */
  const teclear = async (el: HTMLElement, texto: string, vel: number, vivo: () => boolean, alTeclear?: (c: string) => void) => {
    for (const c of texto) {
      if (!vivo()) return false;
      el.textContent += c; alTeclear?.(c);
      await espera(vel * (0.6 + Math.random() * 0.9) + (c === ' ' ? vel * 0.8 : 0) + (/[.,]/.test(c) ? vel * 4 : 0));
    }
    return vivo();
  };
  const borrar = async (el: HTMLElement, vel: number, vivo: () => boolean) => {
    while (el.textContent) {
      if (!vivo()) return false;
      el.textContent = el.textContent.slice(0, -1);
      await espera(vel);
    }
    return vivo();
  };
  /** Arranca una animación cuando su sección entra en pantalla. */
  const alVer = (el: Element, fn: () => void) =>
    new IntersectionObserver((e, o) => { if (e[0].isIntersecting) { fn(); o.disconnect(); } }, { threshold: 0.45 }).observe(el);

  /* ---------- 01 · Reescritura en vivo ---------- */
  {
    const rw = document.querySelector<HTMLElement>('[data-rw]')!;
    const tramos = [...rw.querySelectorAll<HTMLElement>('[data-tramo]')];
    const caret = rw.querySelector<HTMLElement>('.rw__caret')!;
    const estado = rw.querySelector<HTMLElement>('[data-rw-estado]')!;
    const claridad = rw.querySelector<HTMLElement>('[data-rw-claridad]')!;
    const barra = rw.querySelector<HTMLElement>('[data-rw-barra]')!;
    const jerga = rw.querySelector<HTMLElement>('[data-rw-jerga]')!;
    const palabras = rw.querySelector<HTMLElement>('[data-rw-palabras]')!;
    const log = rw.querySelector<HTMLElement>('[data-rw-log]')!;
    const pasos = [{ c: 32, j: 3, p: 2 }, { c: 58, j: 2, p: 2 }, { c: 79, j: 1, p: 1 }, { c: 96, j: 0, p: 0 }];
    let turno = 0;

    const contar = (el: HTMLElement, hasta: number) => {
      const desde = Number(el.textContent); const t0 = performance.now();
      const f = (t: number) => { const k = Math.min((t - t0) / 600, 1); el.textContent = String(Math.round(desde + (hasta - desde) * k)); if (k < 1) requestAnimationFrame(f); };
      requestAnimationFrame(f);
    };
    const metricas = (i: number) => {
      contar(claridad, pasos[i].c); contar(jerga, pasos[i].j); contar(palabras, pasos[i].p);
      barra.style.width = pasos[i].c + '%';
      rw.style.setProperty('--salud', String(pasos[i].c / 100));
    };
    const reiniciar = () => {
      tramos.forEach((t) => {
        t.classList.remove('rw__tramo--activo', 'rw__tramo--hecho'); t.classList.add('rw__tramo--marcado');
        t.querySelector('.rw__contenido')!.textContent = t.dataset.antes!;
      });
      log.innerHTML = ''; estado.textContent = 'Revisando…'; rw.classList.remove('rw--listo');
      claridad.textContent = '32'; jerga.textContent = '3'; palabras.textContent = '2'; metricas(0);
      tramos[tramos.length - 1].after(caret);
    };
    const correr = async () => {
      const id = ++turno; const vivo = () => id === turno;
      reiniciar();
      if (reducir) {
        tramos.forEach((t) => { t.classList.remove('rw__tramo--marcado'); t.classList.add('rw__tramo--hecho'); t.querySelector('.rw__contenido')!.textContent = t.dataset.despues!; });
        metricas(3); estado.textContent = 'Listo'; rw.classList.add('rw--listo'); return;
      }
      await espera(1200);
      for (let i = 0; i < tramos.length; i++) {
        const t = tramos[i]; const cont = t.querySelector<HTMLElement>('.rw__contenido')!;
        if (!vivo()) return;
        t.classList.add('rw__tramo--activo'); estado.textContent = `Sugerencia ${i + 1} de ${tramos.length}`;
        cont.after(caret);
        await espera(1300);
        t.classList.remove('rw__tramo--marcado');
        if (!(await borrar(cont, 22, vivo))) return;
        await espera(180);
        if (!(await teclear(cont, t.dataset.despues!, 55, vivo))) return;
        t.classList.remove('rw__tramo--activo'); t.classList.add('rw__tramo--hecho');
        const li = document.createElement('li');
        li.innerHTML = '<s></s><span></span>';
        li.querySelector('s')!.textContent = t.dataset.antes!; li.querySelector('span')!.textContent = t.dataset.despues!;
        log.append(li);
        metricas(i + 1);
        await espera(500);
      }
      tramos[tramos.length - 1].after(caret);
      estado.textContent = 'Listo · 3 cambios aplicados'; rw.classList.add('rw--listo');
    };
    rw.querySelector('[data-rw-repetir]')!.addEventListener('click', correr);
    reiniciar();
    alVer(rw, correr);
  }

  /* ---------- 02 · Microcopy vivo ---------- */
  {
    const micro = document.querySelector<HTMLElement>('[data-micro]')!;
    const texto = micro.querySelector<HTMLElement>('[data-micro-texto]')!;
    const opciones = ['se entienda.', 'genere confianza.', 'convierta.', 'se sienta humano.'];
    const ciclo = async () => {
      let i = 0;
      while (true) {
        await espera(2200);
        await borrar(texto, 35, () => true);
        await espera(250);
        i = (i + 1) % opciones.length;
        await teclear(texto, opciones[i], 70, () => true);
      }
    };
    if (!reducir) alVer(micro, ciclo);

  }

  /* ---------- 03 · Conversación ---------- */
  {
    const conv = document.querySelector<HTMLElement>('[data-conv]')!;
    const titular = conv.querySelector<HTMLElement>('[data-conv-titular]')!;
    const acento = conv.querySelector<HTMLElement>('[data-conv-acento]')!;
    const mensajes = conv.querySelector<HTMLElement>('[data-conv-mensajes]')!;
    const estado = conv.querySelector<HTMLElement>('[data-conv-estado]')!;
    const dialogo = [
      { de: 'persona', texto: 'Intenté pagar y me salió «Transacción rechazada». ¿Me cobraron?' },
      { de: 'interfaz', texto: 'No te cobramos nada. Tu banco bloqueó el pago como medida de seguridad.' },
      { de: 'interfaz', texto: 'Puedes aprobarlo desde la app de tu banco o pagar con otra tarjeta. Tu carrito sigue guardado.' },
      { de: 'persona', texto: 'Listo, ya lo aprobé en la app' },
      { de: 'interfaz', texto: 'Perfecto. Tu pedido está confirmado y llega el jueves.' },
    ];
    const burbuja = (de: string) => {
      const b = document.createElement('p'); b.className = `burbuja burbuja--${de}`;
      mensajes.append(b);
      // Solo se conservan los últimos mensajes para que el chat no crezca sin fin.
      while (mensajes.children.length > 3) mensajes.firstElementChild!.remove();
      return b;
    };
    const chat = async () => {
      while (true) {
        mensajes.innerHTML = '';
        for (const m of dialogo) {
          if (m.de === 'persona') {
            await espera(900);
            burbuja('persona').textContent = m.texto;
          } else {
            await espera(600);
            estado.textContent = 'escribiendo…';
            const b = burbuja('interfaz');
            b.innerHTML = '<span class="puntos"><i></i><i></i><i></i></span>';
            await espera(1300);
            b.textContent = '';
            await teclear(b, m.texto, 28, () => true);
            estado.textContent = 'en línea';
          }
        }
        await espera(3500);
      }
    };
    const iniciar = async () => {
      if (reducir) {
        titular.textContent = 'Diseño contenido que hace que un producto '; acento.textContent = 'se entienda.';
        dialogo.slice(0, 3).forEach((m) => { burbuja(m.de).textContent = m.texto; });
        return;
      }
      chat();
      await espera(500);
      await teclear(titular, 'Diseño contenido que hace que un producto ', 55, () => true);
      await teclear(acento, 'se entienda.', 85, () => true);
    };
    alVer(conv, iniciar);
  }

  /* ---------- 05 · Del problema al impacto ---------- */
  {
    const imp = document.querySelector<HTMLElement>('[data-imp]')!;
    const titulo = imp.querySelector<HTMLElement>('[data-imp-titulo]')!;
    const ayuda = imp.querySelector<HTMLElement>('[data-imp-ayuda]')!;
    const botones = [...imp.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    const antes = { t: 'Sincronización inteligente', a: 'Optimiza la gestión de contenidos multimedia.' };
    const despues = { t: 'Guardar fotos con wifi', a: 'Se guardan solas al conectarte a wifi. No usan tus datos móviles.' };
    const duracion = [3200, 5200, 3200, 4600];
    let turno = 0;

    const pintar = (n: number) => {
      for (let k = 0; k < 4; k++) imp.classList.toggle(`imp--e${k}`, n >= k);
      imp.dataset.estado = String(n);
      botones.forEach((b, k) => {
        b.classList.toggle('activo', k === n); b.classList.toggle('hecho', k < n);
        b.style.setProperty('--dur', `${duracion[k]}ms`);
      });
    };
    const ir = async (n: number, animar: boolean) => {
      const id = ++turno; const vivo = () => id === turno;
      pintar(n);
      if (n === 0) { titulo.textContent = antes.t; ayuda.textContent = antes.a; }
      else if (n === 1 && animar) {
        titulo.textContent = antes.t; ayuda.textContent = antes.a;
        await espera(500);
        if (!(await borrar(titulo, 25, vivo))) return;
        if (!(await teclear(titulo, despues.t, 60, vivo))) return;
        if (!(await borrar(ayuda, 12, vivo))) return;
        if (!(await teclear(ayuda, despues.a, 30, vivo))) return;
      } else { titulo.textContent = despues.t; ayuda.textContent = despues.a; }
      if (reducir) return;
      const restante = n === 1 && animar ? 1400 : duracion[n];
      await espera(restante);
      if (vivo()) ir((n + 1) % 4, true);
    };
    botones.forEach((b) => b.addEventListener('click', () => ir(Number(b.dataset.ir), true)));
    if (reducir) { pintar(3); titulo.textContent = despues.t; ayuda.textContent = despues.a; }
    else { pintar(0); alVer(imp, () => ir(0, true)); }
  }
</script>

<style>
  .intro { padding-block: clamp(3rem, 8vw, 6rem) 2rem; }
  .intro h1 { font-size: clamp(2.5rem, 7vw, 5rem); letter-spacing: -0.045em; }
  .intro h1 em { color: var(--acento); }
  .intro__texto { max-width: 52ch; color: var(--texto-suave); font-size: 1.125rem; margin: 1.5rem 0 0; }

  .propuesta { padding-top: clamp(4rem, 10vw, 7rem); }
  .cab { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; margin-bottom: 1.5rem; max-width: 54rem; }
  .cab__num { font-family: var(--display); font-weight: 600; font-size: 1rem; color: var(--acento-texto); padding-top: 0.35rem; }
  .cab h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.035em; display: flex; align-items: center; gap: 0.6rem; }
  .cab__tag { font-family: var(--sans); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; padding: 0.2rem 0.55rem; border-radius: 999px; background: var(--acento-suave); color: var(--acento-texto); }
  .cab p { margin: 0.6rem 0 0; color: var(--texto-suave); }
  .cab strong { color: var(--texto); font-weight: 600; }

  .lienzo {
    position: relative; overflow: hidden;
    min-height: clamp(28rem, 66vh, 40rem);
    border-radius: var(--radio); background: var(--superficie);
    padding: clamp(1.25rem, 5vw, 4rem);
  }
  .lienzo p { margin: 0; }
  .titular { font-family: var(--display); font-weight: 600; font-size: clamp(2.25rem, 6.4vw, 5.75rem); line-height: 1; letter-spacing: -0.045em; }
  em { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; color: var(--acento); }
  .caret { display: inline-block; width: 0.07em; height: 0.82em; margin-left: 0.05em; background: var(--acento); vertical-align: -0.04em; animation: parpadeo 1.05s steps(1) infinite; }
  @keyframes parpadeo { 50% { opacity: 0; } }
  @keyframes entrar { from { opacity: 0; transform: translateY(8px); } }
  .repetir { position: absolute; right: 1.25rem; bottom: 1.25rem; z-index: 3; font: inherit; font-size: 0.875rem; padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--borde); background: var(--tarjeta); color: var(--texto); cursor: pointer; }
  .repetir:hover { border-color: var(--texto); }

  /* ---------- 01 ---------- */
  .rw { --salud: 0.32; display: grid; gap: 1.25rem; align-items: stretch; padding: clamp(0.75rem, 2vw, 1.25rem); background: radial-gradient(circle at 15% 0%, color-mix(in srgb, var(--acento) 14%, transparent), transparent 55%), var(--superficie); }
  .rw__editor { display: flex; flex-direction: column; border-radius: calc(var(--radio) - 6px); background: var(--tarjeta); border: 1px solid var(--borde); box-shadow: 0 30px 60px -40px rgb(0 0 0 / 0.35); }
  .rw__barra { display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 1rem; border-bottom: 1px solid var(--borde); font-size: 0.8125rem; color: var(--texto-suave); }
  .rw__pestana--activa { color: var(--texto); font-weight: 500; }
  .rw__pestana--activa::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--acento); margin-right: 0.5rem; }
  .rw__estado { font-variant-numeric: tabular-nums; transition: color 0.4s; }
  .rw--listo .rw__estado { color: #18794e; }
  .rw__texto { flex: 1; display: flex; flex-wrap: wrap; align-content: center; column-gap: 0.25em; padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3.5rem); font-family: var(--display); font-weight: 600; font-size: clamp(2rem, 5vw, 4.5rem); line-height: 1.12; letter-spacing: -0.045em; }
  .rw__tramo { position: relative; border-radius: 6px; transition: background-color 0.4s var(--ease), color 0.4s; }
  .rw__tramo--marcado .rw__contenido { text-decoration: underline wavy color-mix(in srgb, var(--acento) 85%, transparent); text-decoration-thickness: 0.04em; text-underline-offset: 0.18em; text-decoration-skip-ink: none; }
  .rw__tramo--activo { background: color-mix(in srgb, var(--acento) 13%, transparent); box-shadow: 0 0 0 0.1em color-mix(in srgb, var(--acento) 13%, transparent); }
  .rw__tramo--acento:not(.rw__tramo--marcado) { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; color: var(--acento); }
